---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro runs that script in the browser, never during the build, so the
// browser-only localStorage API is safe there. The pure helpers it imports
// (URL normalisation, slug generation, storage parsing/formatting) live in
// src/lib/bookmarks.ts so they can also be unit tested without a browser.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // All the pure logic (URL normalisation, slug generation, storage
  // parsing/formatting) lives in src/lib/bookmarks.ts and is unit tested
  // there. This script only wires that logic up to the DOM and localStorage.
  import {
    STORAGE_KEY,
    formatBookmark,
    generateSlug,
    normalizeUrl,
    parseStoredBookmarks,
    serializeBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  /** Treat localStorage as untrusted: never let a read/write throw. */
  function loadBookmarks(): Bookmark[] {
    try {
      return parseStoredBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]): void {
    try {
      window.localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Storage may be unavailable (private mode, quota, etc). Fail silently —
      // the in-memory list still renders for this session.
    }
  }

  function render(bookmarks: Bookmark[]): void {
    if (!list || !emptyState || !listHeader) return;

    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${formatBookmark(bookmark)}`);
      copyButton.addEventListener('click', () => {
        navigator.clipboard?.writeText(bookmark.slug).then(
          () => {
            const original = copyButton.textContent;
            copyButton.textContent = 'Copied!';
            setTimeout(() => {
              copyButton.textContent = original;
            }, 1500);
          },
          () => {
            // Clipboard access can fail (permissions, insecure context). Ignore.
          },
        );
      });

      item.append(link, separator, slugBadge, copyButton);
      list.appendChild(item);
    }
  }

  function addBookmark(rawUrl: string): void {
    const normalized = normalizeUrl(rawUrl);
    if (!normalized) return;

    const bookmarks = loadBookmarks();

    // Reuse the existing slug if this URL was already saved.
    const existing = bookmarks.find((b) => b.url === normalized);
    const slug = existing?.slug ?? generateSlug();

    const next = existing
      ? bookmarks
      : [...bookmarks, { url: normalized, slug }];

    saveBookmarks(next);
    render(next);
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    const rawUrl = urlInput?.value ?? '';
    addBookmark(rawUrl);
    if (urlInput) urlInput.value = '';
    urlInput?.focus();
  });

  clearAllButton?.addEventListener('click', () => {
    if (!window.confirm('Remove all saved bookmarks?')) return;
    saveBookmarks([]);
    render([]);
  });

  render(loadBookmarks());
</script>

<style>
  .bookmark .separator {
    color: var(--muted);
    font-family: var(--font-body);
  }
</style>
